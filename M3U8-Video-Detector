    function escapeHtml(s) {
        return String(s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    }

    function sanitizeName(s) {
        return String(s || "")
            .replace(/[\\/:*?"<>|\u0000-\u001f]+/g, " ")
            .replace(/\s+/g, " ")
            .trim()
            .slice(0, 80);
    }

    function shortPageTitle() {
        const t = sanitizeName(document.title || "");
        const first = t.split(/\s+[-|–—]\s+/)[0].trim();
        return (first || t).slice(0, 80);
    }

    function displayNameOf(url) {
        try {
            const segs = url.pathname.split("/").filter(Boolean);
            if (!segs.length) return url.hostname;

            const lastRaw = segs[segs.length - 1];
            const last = decodeURIComponent(lastRaw) || lastRaw;
            const generic = /^(index|playlist|master|main|media|manifest|video|stream|prog_index|chunklist|mono|audio)\.(m3u8|m3u|mpd|ts)$/i.test(last);
            const hashLike = /^[0-9a-f]{12,}$/i.test(last);

            if ((generic || hashLike) && segs.length > 1) {
                const parent = decodeURIComponent(segs[segs.length - 2]) || segs[segs.length - 2];
                return parent + "/" + last;
            }
            return last;
        } catch (e) {
            return url.hostname;
        }
    }

    function toolUrlFor(url) {
        const enc = encodeURIComponent;
        const parts = [
            "u=" + enc(url.href),
            "n=" + enc(sanitizeName(document.title || "")),
            "r=" + enc(location.href),
            "o=" + enc(location.origin),
            "a=" + enc(navigator.userAgent || ""),
            "c=" + enc((document.cookie || "").slice(0, 3000))
        ];
        return `${TOOL_SCHEME}://go?${parts.join("&")}`;
    }

    function launchTool(url) {
        const a = document.createElement("a");
        a.href = toolUrlFor(url);
