        }
        showViewerMessage("Đang tải video…");

        viewerVideo.onloadeddata = null;
        viewerVideo.onerror = null;

        if (viewerHls) {
            try { viewerHls.destroy(); } catch (e) { }
            viewerHls = null;
        }
        try {
            viewerVideo.pause();
            viewerVideo.removeAttribute("src");
            viewerVideo.load();
        } catch (e) { }

        viewerVideo.onloadeddata = () => {
            if (viewerUrl === href) showViewerMessage("");
        };
        viewerVideo.onerror = () => {
            // load() sau khi xoá src cũng bắn error code 4 — bỏ qua trường hợp đó.
            if (viewerUrl !== href || viewerHls) return;
            if (!viewerVideo.getAttribute("src")) return;
            showViewerMessage("Không phát được video này. Bấm ↗ để mở link hoặc dùng nút Tải.");
        };

        // MP4/WebM: trình duyệt phát trực tiếp.
        if (/\.(mp4|webm|ogg|ogv|mov|m4v)(?:[?#]|$)/i.test(url.pathname)) {
            viewerVideo.src = href;
            viewerVideo.play().catch(() => { });
            return;
        }

        // Chrome/Edge/Firefox: dùng hls.js do @require nạp sẵn.
        if (typeof Hls !== "undefined" && Hls.isSupported()) {
            const hls = new Hls({ lowLatencyMode: false });
            viewerHls = hls;
            hls.on(Hls.Events.ERROR, (event, data) => {
                if (!data || !data.fatal) return;
                if (viewerHls !== hls) return;
                showViewerMessage("Không phát được video trong panel. Bấm ↗ để mở link hoặc dùng nút Tải.");
                try { hls.destroy(); } catch (e) { }
                viewerHls = null;
            });
            hls.on(Hls.Events.MANIFEST_PARSED, () => {
                if (viewerHls !== hls) return;
                showViewerMessage("");
                viewerVideo.play().catch(() => { });
            });
            hls.loadSource(href);
            hls.attachMedia(viewerVideo);
            return;
        }

        // Safari/iOS (không có MSE/hls.js) có HLS gốc.
        if (viewerVideo.canPlayType("application/vnd.apple.mpegurl")) {
            viewerVideo.src = href;
            viewerVideo.play().catch(() => { });
            return;
        }

        showViewerMessage("Trình duyệt chưa hỗ trợ HLS trong panel. Bấm ↗ để mở link hoặc dùng nút Tải.");
    }

