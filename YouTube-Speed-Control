// ==UserScript==
// @name         YouTube Speed Control
// @namespace    https://youtube.com/
// @version      6.2
// @description  Điều chỉnh tốc độ YouTube — Bảng chọn tốc độ + phím tắt Shift+> / Shift+< / Ctrl+/ + popup tốc độ đã fix
// @author       You
// @match        https://www.youtube.com/*
// @match        https://youtube.com/*
// @grant        GM_addStyle
// @run-at       document-idle
// @downloadURL  https://raw.githubusercontent.com/nnTuyen/Script-for-me/main/YouTube-Speed-Control
// @updateURL    https://raw.githubusercontent.com/nnTuyen/Script-for-me/main/YouTube-Speed-Control
// ==/UserScript==

(function () {
    'use strict';

    const SPEED_STEPS = [
        0.25, 0.5, 0.75,
        1.0, 1.25, 1.5, 1.75,
        2.0, 2.1, 2.2, 2.3,
        2.5, 3.0, 4.0, 6.0
    ];
    const DEFAULT_SPEED = 1.0;
    const SLIDER_STEP = 0.05;
    const MIN_SPEED = 0.25;
    const MAX_SPEED = 6.0;
    const DISPLAY_DURATION = 600;

    let speedBtn = null;
    let speedPanel = null;
    let trackedVideo = null;
    let overlay = null;
    let hideTimeout = null;
    let popupSeq = 0;

    GM_addStyle(`
        #yt-speed-btn {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            vertical-align: top;
            color: #fff;
            font-family: 'YouTube Sans','Roboto',Arial,sans-serif;
            font-size: 14px;
            font-weight: 700;
            min-width: 40px;
            padding: 0 6px;
            text-align: center;
            cursor: pointer;
            white-space: nowrap;
            transition: color 0.2s;
            user-select: none;
            background: none;
            border: none;
            box-sizing: border-box;
            opacity: .9;
        }
        #yt-speed-btn:hover { color: #f00; opacity: 1; }

        .yt-speed-panel {
            position: fixed;
            background: rgba(28,28,28,0.92);
            color: #fff;
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            width: 100px;
            z-index: 2147483647;
            box-shadow: 0 8px 32px rgba(0,0,0,0.45);
            border: 1px solid rgba(255,255,255,0.12);
            overflow: hidden;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.18s ease, transform 0.18s ease;
            transform: translateY(8px);
            backdrop-filter: blur(20px) saturate(180%);
            -webkit-backdrop-filter: blur(20px) saturate(180%);
        }
        .yt-speed-panel.visible {
            opacity: 1;
            pointer-events: auto;
            transform: translateY(0);
        }

        .yt-speed-slider {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 8px;
            border-bottom: 1px solid rgba(255,255,255,0.1);
            gap: 4px;
        }
        .yt-speed-slider-btn {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.2);
            background: transparent;
            color: #fff;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: background 0.15s, transform 0.15s;
            flex-shrink: 0;
            padding: 0;
            line-height: 1;
        }
        .yt-speed-slider-btn:hover {
            background: rgba(255,255,255,0.15);
            transform: scale(1.1);
        }
        .yt-speed-slider-btn:active { transform: scale(0.95); }

        .yt-speed-slider-val {
            font-size: 13px;
            font-weight: 700;
            text-align: center;
            min-width: 32px;
        }

        .yt-speed-list {
            max-height: 240px;
            overflow-y: auto;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,0.2) transparent;
        }
        .yt-speed-list::-webkit-scrollbar { width: 4px; }
        .yt-speed-list::-webkit-scrollbar-thumb {
            background: rgba(255,255,255,0.2);
            border-radius: 2px;
        }

        .yt-speed-item {
            cursor: pointer;
            height: 30px;
            line-height: 30px;
            font-size: 13px;
            text-align: center;
            transition: background 0.15s, color 0.15s;
        }
        .yt-speed-item:hover { background: rgba(255,255,255,0.1); }
        .yt-speed-item.active {
            color: #f00;
            font-weight: bold;
            background: rgba(255,68,68,0.1);
        }

        #yt-speed-clone {
            position: absolute;
            top: 12%;
            left: 50%;
            transform: translateX(-50%) scale(0.9);
            z-index: 2147483647;
            background: rgba(28, 28, 28, 0.85);
            color: #fff;
            font-family: 'YouTube Sans', 'Roboto', Arial, sans-serif;
            font-size: 1.8rem;
            font-weight: 700;
            padding: 14px 28px;
            border-radius: 4px;
            pointer-events: none;
            opacity: 0;
            transition: opacity 0.1s ease, transform 0.1s ease;
            white-space: nowrap;
        }
        #yt-speed-clone.visible {
            opacity: 1;
            transform: translateX(-50%) scale(1);
        }
    `);

    function formatSpeed(speed) {
        return Number(speed).toFixed(2).replace(/\.?0+$/, '');
    }

    function getVideo() {
        return document.querySelector('video');
    }

    function getPlayerContainer() {
        return document.querySelector('.html5-video-container')
            || document.querySelector('#movie_player')
            || document.querySelector('ytd-player')
            || document.body;
    }

    function cleanupDuplicateOverlays(keep = null) {
        document.querySelectorAll('#yt-speed-clone').forEach(el => {
            if (el !== keep) el.remove();
        });
    }

    function createOverlay() {
        const container = getPlayerContainer();

        if (overlay && overlay.isConnected) {
            cleanupDuplicateOverlays(overlay);
            if (overlay.parentNode !== container) container.appendChild(overlay);
            return overlay;
        }

        overlay = document.getElementById('yt-speed-clone');

        if (!overlay) {
            overlay = document.createElement('div');
            overlay.id = 'yt-speed-clone';
        }

        cleanupDuplicateOverlays(overlay);

        if (container !== document.body) {
            const pos = getComputedStyle(container).position;
            if (pos === 'static') container.style.position = 'relative';
        }

        if (overlay.parentNode !== container) container.appendChild(overlay);
        return overlay;
    }

    function showSpeedPopup(speed, isReset = false) {
        const el = createOverlay();
        const shownSpeed = formatSpeed(speed);
        const seq = ++popupSeq;

        el.textContent = isReset ? '↺ ' + shownSpeed + 'x' : shownSpeed + 'x';

        clearTimeout(hideTimeout);

        el.classList.remove('visible');
        void el.offsetWidth;
        el.classList.add('visible');

        hideTimeout = setTimeout(() => {
            if (seq === popupSeq && el === overlay) {
                el.classList.remove('visible');
            }
        }, DISPLAY_DURATION);
    }

    function removeOverlay() {
        clearTimeout(hideTimeout);
        hideTimeout = null;
        overlay = null;
        document.querySelectorAll('#yt-speed-clone').forEach(el => el.remove());
    }

    function setSpeed(speed, isReset = false) {
        speed = Math.round(speed * 100) / 100;
        speed = Math.max(MIN_SPEED, Math.min(MAX_SPEED, speed));

        const video = getVideo();
        let actualSpeed = speed;

        if (video) {
            video.playbackRate = speed;
            actualSpeed = Math.round(video.playbackRate * 100) / 100;
        }

        updateUI(actualSpeed);
        showSpeedPopup(actualSpeed, isReset);
    }

    function updateUI(speed) {
        speed = Math.round(speed * 100) / 100;

        if (speedBtn) {
            const s = speedBtn.querySelector('span');
            if (s) s.textContent = formatSpeed(speed) + '×';
        }

        const sv = document.getElementById('yt-speed-slider-val');
        if (sv) sv.textContent = formatSpeed(speed) + 'x';

        if (!speedPanel) return;

        speedPanel.querySelectorAll('.yt-speed-item').forEach(item => {
            const itemSpeed = parseFloat(item.dataset.speed);
            item.classList.toggle('active', Math.abs(itemSpeed - speed) < 0.001);
        });
    }

    function createSpeedButton() {
        const existing = document.getElementById('yt-speed-btn');
        if (existing) {
            speedBtn = existing;
            return speedBtn;
        }

        const settingsBtn = document.querySelector('.ytp-settings-button');
        if (!settingsBtn || !settingsBtn.parentNode) return null;

        speedBtn = document.createElement('button');
        speedBtn.type = 'button';
        speedBtn.id = 'yt-speed-btn';
        speedBtn.className = 'ytp-button';
        speedBtn.title = 'Tốc độ phát';

        const span = document.createElement('span');
        const video = getVideo();
        span.textContent = formatSpeed(video ? video.playbackRate : DEFAULT_SPEED) + '×';
        speedBtn.appendChild(span);

        speedBtn.addEventListener('click', e => {
            e.stopPropagation();
            togglePanel();
        });

        settingsBtn.parentNode.insertBefore(speedBtn, settingsBtn);
        return speedBtn;
    }

    function createSpeedPanel() {
        if (speedPanel && speedPanel.isConnected) return speedPanel;

        speedPanel = document.createElement('div');
        speedPanel.className = 'yt-speed-panel';

        const slider = document.createElement('div');
        slider.className = 'yt-speed-slider';

        const btnM = document.createElement('button');
        btnM.className = 'yt-speed-slider-btn';
        btnM.textContent = '-';
        btnM.addEventListener('click', e => {
            e.stopPropagation();
            sliderChange(-1);
        });

        const val = document.createElement('span');
        val.className = 'yt-speed-slider-val';
        val.id = 'yt-speed-slider-val';

        const v = getVideo();
        val.textContent = formatSpeed(v ? v.playbackRate : DEFAULT_SPEED) + 'x';

        const btnP = document.createElement('button');
        btnP.className = 'yt-speed-slider-btn';
        btnP.textContent = '+';
        btnP.addEventListener('click', e => {
            e.stopPropagation();
            sliderChange(1);
        });

        slider.append(btnM, val, btnP);
        speedPanel.appendChild(slider);

        const list = document.createElement('div');
        list.className = 'yt-speed-list';

        SPEED_STEPS.forEach(sp => {
            const item = document.createElement('div');
            item.className = 'yt-speed-item';
            item.dataset.speed = sp;
            item.textContent = formatSpeed(sp) + 'x';
            item.addEventListener('click', e => {
                e.stopPropagation();
                setSpeed(sp);
            });
            list.appendChild(item);
        });

        speedPanel.appendChild(list);
        document.body.appendChild(speedPanel);

        document.addEventListener('click', e => {
            if (
                speedPanel.classList.contains('visible') &&
                !speedPanel.contains(e.target) &&
                !speedBtn?.contains(e.target)
            ) {
                hidePanel();
            }
        }, true);

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && speedPanel.classList.contains('visible')) {
                hidePanel();
            }
        });

        return speedPanel;
    }

    function positionPanel() {
        if (!speedBtn || !speedPanel) return;

        const r = speedBtn.getBoundingClientRect();
        speedPanel.style.left = (r.left + r.width / 2 - speedPanel.offsetWidth / 2) + 'px';
        speedPanel.style.bottom = (window.innerHeight - r.top + 8) + 'px';
    }

    function showPanel() {
        createSpeedPanel();
        positionPanel();
        updateUI(getVideo()?.playbackRate || DEFAULT_SPEED);
        speedPanel.classList.add('visible');

        const active = speedPanel.querySelector('.yt-speed-item.active');
        if (active) active.scrollIntoView({ block: 'center', behavior: 'smooth' });
    }

    function hidePanel() {
        if (speedPanel) speedPanel.classList.remove('visible');
    }

    function togglePanel() {
        if (!speedPanel || !speedPanel.classList.contains('visible')) {
            showPanel();
        } else {
            hidePanel();
        }
    }

    function sliderChange(dir) {
        const video = getVideo();
        if (!video) return;
        setSpeed(video.playbackRate + dir * SLIDER_STEP);
    }

    function attachVideoListener() {
        const video = getVideo();
        if (!video || video === trackedVideo) return;

        trackedVideo = video;

        video.addEventListener('ratechange', () => {
            updateUI(video.playbackRate);
        });

        createSpeedButton();
        updateUI(video.playbackRate);
    }

    let obsTimer = null;

    const obs = new MutationObserver(() => {
        clearTimeout(obsTimer);
        obsTimer = setTimeout(() => {
            attachVideoListener();

            if (!document.getElementById('yt-speed-btn')) {
                speedBtn = null;
                createSpeedButton();

                const v = getVideo();
                if (v) updateUI(v.playbackRate);
            }

            cleanupDuplicateOverlays(overlay);
        }, 200);
    });

    obs.observe(document.documentElement, {
        childList: true,
        subtree: true
    });

    document.addEventListener('yt-navigate-finish', () => {
        setTimeout(() => {
            trackedVideo = null;
            speedBtn = null;
            removeOverlay();
            attachVideoListener();
        }, 500);
    });

    window.addEventListener('resize', () => {
        if (speedPanel?.classList.contains('visible')) positionPanel();
    });

    window.addEventListener('scroll', () => {
        if (speedPanel?.classList.contains('visible')) positionPanel();
    }, true);

    attachVideoListener();

    function findClosestIndex(rate) {
        let idx = 0;
        let min = Infinity;

        SPEED_STEPS.forEach((s, i) => {
            const d = Math.abs(s - rate);
            if (d < min) {
                min = d;
                idx = i;
            }
        });

        return idx;
    }

    document.addEventListener('keydown', function (e) {
        const tag = e.target.tagName;

        if (tag === 'INPUT' || tag === 'TEXTAREA' || e.target.isContentEditable) return;
        if (e.altKey || e.metaKey) return;

        const video = getVideo();
        if (!video) return;

        if (e.ctrlKey && e.key === '/') {
            e.preventDefault();
            e.stopPropagation();
            e.stopImmediatePropagation();
            setSpeed(DEFAULT_SPEED, true);
            return;
        }

        if (!e.shiftKey || e.ctrlKey) return;
        if (e.key !== '>' && e.key !== '<') return;

        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();

        const cur = findClosestIndex(video.playbackRate);
        const next = e.key === '>'
            ? Math.min(cur + 1, SPEED_STEPS.length - 1)
            : Math.max(cur - 1, 0);

        setSpeed(SPEED_STEPS[next]);
    }, true);
})();
