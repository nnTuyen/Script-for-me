  const SUB_RE = /\.(?:ass|ssa)(?:[?#]|$)/i;

  // Bắt URL phụ đề trong HTML/JSON, kể cả dạng escape "https:\/\/...".
  const SUB_URL_RE = /(?:https?:)?(?:\\?\/){2}sub\.ykimg\.com(?:\\?\/)[^"'\s<>]+?\.(?:ass|ssa)(?:\\?[?][^"'\s<>]*)?/gi;

