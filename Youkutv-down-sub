      return originalOpen.call(this, method, url, ...rest);
    }

    patchedOpen.__ykAssPatched = true;
    try { proto.open = patchedOpen; } catch (_) { /* bỏ qua */ }
  }

  let performanceIndex = 0;

  function scanPerformanceEntries() {
    let entries;
