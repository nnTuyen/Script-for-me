   *  Bắt request: fetch + XMLHttpRequest + performance + HTML
   * ------------------------------------------------------------------ */

  function checkRequestUrl(rawUrl) {
    if (!rawUrl) return;
    try {
      const absolute = new URL(String(rawUrl), location.href).href;
      if (SUB_RE.test(absolute)) handleFoundSubtitle(absolute, 'network', currentLanguageHint());
    } catch (_) { /* bỏ qua */ }
  }

  function hookFetch() {
    const originalFetch = W.fetch;
    if (typeof originalFetch !== 'function' || originalFetch.__ykAssPatched) return;

    function patchedFetch(...args) {
      try {
        const input = args[0];
        const url = typeof input === 'string' ? input : (input && input.url);
        if (url) checkRequestUrl(url);
      } catch (_) { /* bỏ qua */ }

      return originalFetch.apply(this, args);
    }

    patchedFetch.__ykAssPatched = true;
    try { W.fetch = patchedFetch; } catch (_) { /* bỏ qua */ }
  }

  function hookXhr() {
    const proto = W.XMLHttpRequest && W.XMLHttpRequest.prototype;
    if (!proto || proto.open.__ykAssPatched) return;

    const originalOpen = proto.open;
    function patchedOpen(method, url, ...rest) {
