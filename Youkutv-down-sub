  const VIETNAMESE_CHAR_RE = /[ăâđêôơưĂÂĐÊÔƠƯạảấầẩẫậắằẳẵặẹẻẽếềểễệỉịọỏốồổỗộớờởỡợụủứừửữựỳỵỷỹ]/g;

  /* ------------------------------------------------------------------ *
   *  Tiện ích
   * ------------------------------------------------------------------ */

  function getPref(key, fallback) {
    try {
      if (typeof GM_getValue === 'function') {
        const value = GM_getValue(key, fallback);
        return value === undefined ? fallback : value;
      }
    } catch (_) { /* bỏ qua */ }

    try {
      const raw = localStorage.getItem(PREFS_KEY + '_' + key);
      return raw === null ? fallback : JSON.parse(raw);
    } catch (_) {
      return fallback;
    }
  }

  function setPref(key, value) {
    try {
      if (typeof GM_setValue === 'function') {
        GM_setValue(key, value);
        return;
      }
    } catch (_) { /* bỏ qua */ }

    try {
      localStorage.setItem(PREFS_KEY + '_' + key, JSON.stringify(value));
    } catch (_) { /* bỏ qua */ }
  }

  function safeDecode(value) {
    try { return decodeURIComponent(value); } catch (_) { return value; }
  }

  function sanitizeFilename(name) {
    let result = String(name || '')
      .replace(/[\u0000-\u001f<>:"/\\|?*]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim()
      .replace(/[. ]+$/g, '')
      .slice(0, 110)
      .trim();

    if (/^(con|prn|aux|nul|com[1-9]|lpt[1-9])$/i.test(result)) {
      result = '_' + result;
    }
    return result || 'youku';
  }

  function normalizeTitleText(value) {
    return String(value || '').replace(/\s+/g, ' ').trim();
  }

  function stripSiteSuffix(value) {
    let title = normalizeTitleText(value);

    // Cắt phần đuôi kiểu "-YOUKU-Drama, Film, Show, Anime".
    const youkuIndex = title.search(/\s*[-–—_|]\s*(?:YOUKU|Youku|优酷|優酷)/i);
    if (youkuIndex > 0) title = title.slice(0, youkuIndex).trim();

    return title
      .replace(/\s*[-–—_|]\s*(?:Watch online|Watch Online|在线观看|線上看)\s*$/i, '')
      .replace(/\s*[-–—_|]\s*(?:高清|超清|蓝光)?(?:正版)?(?:视频)?(?:在线观看)\s*$/i, '')
      .trim();
  }

  // Tên tập đang phát: ưu tiên tiêu đề trên player, sau đó tới tập đang
  // được chọn trong danh sách tập. Tên này đổi theo video/tập đang xem.
  function currentEpisodeTitle() {
    const selectors = [
      '#youku-dashboard .kui-toplayer-title',
      '.kui-toplayer-title',
      '.new-pic-text-item .new-currentTitle',
      '.new-anthology-title-wrap .new-currentTitle',
      '.new-currentTitle',
    ];

    for (const selector of selectors) {
      const nodes = document.querySelectorAll(selector);
      for (const node of nodes) {
        const text = normalizeTitleText(node.textContent);
        if (text && text.length <= 180) return text;
      }
    }
    return '';
  }

  // Tên show/phim (dùng để ghép với tên tập).
  function currentShowTitle() {
    const selectors = ['h3.new-title-name', '.new-title-name'];

    for (const selector of selectors) {
      const node = document.querySelector(selector);
      const text = normalizeTitleText(node && node.textContent);
      if (text && text.length <= 180) return text;
    }
    return '';
  }

  function pageBaseName() {
    let episode = stripSiteSuffix(currentEpisodeTitle());
    const show = stripSiteSuffix(currentShowTitle());

    if (episode) {
      // Nếu tên tập đã có sẵn tên show thì không ghép lặp lại.
      if (show && !episode.toLowerCase().includes(show.toLowerCase())) {
        return sanitizeFilename(`${show} - ${episode}`);
      }
      return sanitizeFilename(episode);
    }

    // Dự phòng khi chưa đọc được tiêu đề player/danh sách tập.
    let title = stripSiteSuffix(document.title);

    if (!title || /^(?:优酷|優酷|youku(?:\.tv)?)$/i.test(title)) {
      const match = location.pathname.match(/id_([^/]+?)\.html/i);
      title = match ? safeDecode(match[1]).replace(/=+$/g, '') : 'youku';
    }

    return sanitizeFilename(title);
  }

  function prettyUrl(url) {
    try {
      const parsed = new URL(url);
      const file = parsed.pathname.split('/').pop() || '';
      return parsed.hostname + '/' + file;
    } catch (_) {
      return url;
    }
  }

  /* ------------------------------------------------------------------ *
   *  Nhận diện ngôn ngữ phụ đề
   * ------------------------------------------------------------------ */

  function parseTrackInfoValue(value) {
    const raw = String(value || '').trim();
    if (!raw) return null;

    const candidates = [raw];
    try {
      const decoded = decodeURIComponent(raw);
      if (decoded !== raw) candidates.push(decoded);
    } catch (_) { /* bỏ qua */ }

    for (const candidate of candidates) {
      try {
        const parsed = JSON.parse(candidate);
        if (parsed && typeof parsed === 'object') return parsed;
      } catch (_) { /* thử dạng khác */ }
    }
    return null;
  }

  function parseTrackInfoElement(element) {
    if (!element || typeof element.getAttribute !== 'function') return null;

    const info = parseTrackInfoValue(element.getAttribute('data-trackinfo'));
    if (!info) return null;

    const code = String(info.language || '').toUpperCase().trim();
    if (!YOUKU_TRACK_CODES[code]) return null;

    const label = String(element.textContent || '');
    return {
      code,
      auto: /auto-translation/i.test(label),
    };
  }

  function readActiveSubtitleTrack() {
    try {
      const container = document.querySelector('.kui-subtitleicon-subtitles-container');
      if (!container) return null;

      const items = [...container.querySelectorAll('.kui-subtitleicon-subtitle-item[data-trackinfo]')];

      // Track đang chọn có style color:#00A9F5 do player gắn trực tiếp.
      for (const element of items) {
        const inline = String((element.style && element.style.color) || '')
          .replace(/\s+/g, '')
          .toLowerCase();
        if (inline !== ACTIVE_SUBTITLE_COLOR && inline !== 'rgb(0,169,245)') continue;

        const info = parseTrackInfoElement(element);
        if (info) return info;
      }

      // Dự phòng khi player đổi màu bằng CSS thay vì style inline.
      for (const element of items) {
        let computed = '';
        try { computed = getComputedStyle(element).color; } catch (_) { /* bỏ qua */ }
        computed = String(computed || '').replace(/\s+/g, '').toLowerCase();
        if (computed !== 'rgb(0,169,245)') continue;

        const info = parseTrackInfoElement(element);
        if (info) return info;
      }
    } catch (_) { /* bỏ qua */ }

    return null;
  }

  let pendingLanguage = null;

  function rememberSubtitleLanguageFromEvent(event) {
    try {
      const target = event.target;
      if (!target || typeof target.closest !== 'function') return;

      const element = target.closest(
        '.kui-subtitleicon-subtitles-container .kui-subtitleicon-subtitle-item[data-trackinfo]'
      );
      if (!element) return;

      const info = parseTrackInfoElement(element);
      if (!info) return;

      pendingLanguage = { code: info.code, auto: info.auto, at: Date.now() };
    } catch (_) { /* bỏ qua */ }
  }

  function hookSubtitleLanguageMenu() {
    document.addEventListener('pointerdown', rememberSubtitleLanguageFromEvent, true);
    document.addEventListener('click', rememberSubtitleLanguageFromEvent, true);
  }

  function currentLanguageHint() {
    const now = Date.now();

    if (pendingLanguage && now - pendingLanguage.at < 8000) {
      return { code: pendingLanguage.code, auto: pendingLanguage.auto, source: 'click' };
    }

    const active = readActiveSubtitleTrack();
    return active ? { ...active, source: 'active' } : null;
  }

  function normalizeLanguageHint(hint) {
    if (!hint || typeof hint !== 'object') return null;

    const code = String(hint.code || '').toUpperCase().trim();
    if (!YOUKU_TRACK_CODES[code]) return null;

    return {
      code,
      auto: !!hint.auto,
      source: hint.source === 'click' ? 'click' : 'active',
    };
  }

  function languageDefinition(code) {
    const def = LANGUAGE_DEFS[String(code || '')];
    return def ? { ...def, auto: false } : null;
  }

  function languageFromYoukuCode(code, auto) {
    const canonical = YOUKU_TRACK_CODES[String(code || '').toUpperCase()];
    const def = canonical ? LANGUAGE_DEFS[canonical] : null;
    return def ? { ...def, auto: !!auto } : null;
  }

  function chooseLanguage(uiHint, detected) {
    const uiLanguage = uiHint ? languageFromYoukuCode(uiHint.code, uiHint.auto) : null;

    if (detected && detected.code) {
      const detectedLanguage = languageDefinition(detected.code);

      if (detectedLanguage && detected.confidence === 'high') {
        // Nếu chỉ biết là tiếng Trung, giữ phiên bản Giản thể/Phồn thể từ menu.
        if (uiLanguage && detected.code === 'zh' && /^zh(?:-|$)/.test(uiLanguage.code)) {
          return uiLanguage;
        }

        if (uiLanguage && uiLanguage.code === detectedLanguage.code) {
          return uiLanguage;
        }

        return detectedLanguage;
      }

      if (!uiLanguage && detectedLanguage) return detectedLanguage;
    }

    return uiLanguage;
  }

  function countMatches(text, regex) {
    const matches = String(text || '').match(regex);
    return matches ? matches.length : 0;
  }

  function assDialogueBody(line) {
    let commas = 0;
    for (let index = 0; index < line.length; index++) {
      if (line.charCodeAt(index) !== 44) continue; // dấu phẩy
      commas++;
      if (commas === 9) return line.slice(index + 1);
    }
    return line;
  }

  function extractAssDialogueText(text) {
    const lines = String(text || '').split(/\r?\n/);
    const chunks = [];

    for (const line of lines) {
      if (!/^\s*Dialogue\s*:/i.test(line)) continue;

      const clean = assDialogueBody(line)
        .replace(/\{[^}]*\}/g, ' ')
        .replace(/\\[Nn]/g, ' ')
        .replace(/\\h/gi, ' ')
        .replace(/<[^>]*>/g, ' ')
        .replace(/\\[A-Za-z][^\\\s]*/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();

      if (clean) chunks.push(clean);
      if (chunks.length >= 5000) break;
    }

    return chunks.join('\n');
  }

  function scoreLatinLanguage(text) {
    const words = String(text || '')
      .toLowerCase()
      .match(/[a-z\u00C0-\u024F\u1E00-\u1EFF]+/g) || [];

    if (words.length < 4) {
      return { code: '', score: 0, secondScore: 0, wordCount: words.length };
    }

    const counts = new Map();
    for (const word of words) counts.set(word, (counts.get(word) || 0) + 1);

    let bestCode = '';
    let bestScore = 0;
    let secondScore = 0;

    for (const [code, stopwords] of Object.entries(LATIN_STOPWORDS)) {
      let score = 0;
      for (const word of stopwords) score += counts.get(word) || 0;

      if (score > bestScore) {
        secondScore = bestScore;
        bestScore = score;
        bestCode = code;
      } else if (score > secondScore) {
        secondScore = score;
      }
    }

    return { code: bestCode, score: bestScore, secondScore, wordCount: words.length };
  }

  function detectAssLanguage(text) {
    const dialogue = extractAssDialogueText(text);
    if (!dialogue || dialogue.length < 2) return null;

    const cjk = countMatches(dialogue, /[\u3400-\u4DBF\u4E00-\u9FFF\uF900-\uFAFF]/g);
    const kana = countMatches(dialogue, /[\u3040-\u30FF]/g);
    const hangul = countMatches(dialogue, /[\uAC00-\uD7AF\u1100-\u11FF]/g);
    const thai = countMatches(dialogue, /[\u0E00-\u0E7F]/g);
    const arabic = countMatches(dialogue, /[\u0600-\u06FF\u0750-\u077F]/g);
    const cyrillic = countMatches(dialogue, /[\u0400-\u04FF]/g);
    const hebrew = countMatches(dialogue, /[\u0590-\u05FF]/g);
    const latin = countMatches(dialogue, /[A-Za-z\u00C0-\u024F\u1E00-\u1EFF]/g);
    const vietnamese = countMatches(dialogue, VIETNAMESE_CHAR_RE);
    const total = cjk + kana + hangul + thai + arabic + cyrillic + hebrew + latin;

    if (total < 4) return null;

    if (hangul >= 5 && hangul >= total * 0.1) return { code: 'ko', confidence: 'high' };
    if (kana >= 5 && kana > cjk * 0.08) return { code: 'ja', confidence: 'high' };
    if (cjk >= 5 && cjk >= latin * 0.3) return { code: 'zh', confidence: 'high' };
    if (thai >= 5 && thai >= total * 0.1) return { code: 'th', confidence: 'high' };
    if (arabic >= 5 && arabic >= total * 0.1) return { code: 'ar', confidence: 'high' };
    if (hebrew >= 5 && hebrew >= total * 0.1) return { code: 'he', confidence: 'high' };
    if (cyrillic >= 5 && cyrillic >= total * 0.1) return { code: 'ru', confidence: 'high' };

    if (vietnamese >= 10 && vietnamese / Math.max(1, latin) >= 0.02) {
      return { code: 'vi', confidence: 'high' };
    }

    const latinScore = scoreLatinLanguage(dialogue);
    if (
      latinScore.code &&
      latinScore.score >= 4 &&
      latinScore.score >= latinScore.secondScore + 2 &&
      latinScore.score / Math.max(1, latinScore.wordCount) >= 0.01
    ) {
      return { code: latinScore.code, confidence: 'high' };
    }

    if (vietnamese >= 3 && vietnamese / Math.max(1, latin) >= 0.01) {
      return { code: 'vi', confidence: 'low' };
    }
    if (latinScore.code) return { code: latinScore.code, confidence: 'low' };
    if (latin >= 20) return { code: 'en', confidence: 'low' };
    return null;
  }

  function decodeAssBuffer(buffer) {
    if (typeof TextDecoder !== 'function') return '';

    let bytes;
    try {
      bytes = buffer instanceof Uint8Array ? buffer : new Uint8Array(buffer);
    } catch (_) {
      return '';
    }
    if (!bytes || !bytes.length) return '';

    if (bytes[0] === 0xFF && bytes[1] === 0xFE) {
      try { return new TextDecoder('utf-16le').decode(bytes); } catch (_) { /* bỏ qua */ }
    }
    if (bytes[0] === 0xFE && bytes[1] === 0xFF) {
      try { return new TextDecoder('utf-16be').decode(bytes); } catch (_) { /* bỏ qua */ }
    }

    let best = '';
    let bestBad = Infinity;

    for (const encoding of ['utf-8', 'gb18030', 'big5']) {
      try {
        const decoded = new TextDecoder(encoding).decode(bytes);
        const bad = (decoded.match(/\uFFFD/g) || []).length;

        if (bad < bestBad) {
          best = decoded;
          bestBad = bad;
        }
        if (bad === 0) break;
      } catch (_) { /* encoding không được hỗ trợ */ }
    }

    return best;
  }

  function resolveItemLanguage(item) {
    if (!item) return;

    let hint = item.languageHint;
    if (!hint) hint = readActiveSubtitleTrack();

    item.language = chooseLanguage(hint, item.detectedLanguage);
    item.languageResolved = true;
  }

  function sleep(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  function normalizeSubtitleUrl(raw) {
    let value = String(raw || '').trim();
    value = value
      .replace(/\\+u002f/gi, '/')
      .replace(/\\\//g, '/')
      .replace(/&amp;/gi, '&');

    if (value.startsWith('//')) value = 'https:' + value;
    return value;
  }

  function isSubtitleUrl(url) {
    return /^https?:\/\//i.test(url) && SUB_RE.test(url);
  }

  function subtitleKey(url) {
    try {
      const parsed = new URL(url);
      return parsed.hostname.toLowerCase() + parsed.pathname;
    } catch (_) {
      return url;
    }
  }

  /* ------------------------------------------------------------------ *
   *  Kho phụ đề đã bắt được
   * ------------------------------------------------------------------ */

  const subtitles = [];
  const subtitleByKey = new Map();
  let autoDownload = false;
  let lastPath = location.pathname;

  try { autoDownload = !!getPref('autoDownload', false); } catch (_) { /* bỏ qua */ }

  function startPrefetch(item) {
    if (!item || item.prefetchPromise || item.buffer) return item.prefetchPromise;

    item.prefetching = true;
    item.prefetchPromise = (async () => {
      try {
        // Tải sẵn file nhỏ này để vừa nhận diện ngôn ngữ, vừa tái sử dụng khi bấm Tải.
        const buffer = await getBuffer(item.url);
        item.buffer = buffer;
        item.detectedLanguage = detectAssLanguage(decodeAssBuffer(buffer));
      } catch (error) {
        console.warn('[Youku ASS] Không phân tích được phụ đề:', error);
      } finally {
        item.prefetching = false;

        if (!item.languageHint) {
          const active = readActiveSubtitleTrack();
          if (active) item.languageHint = { ...active, source: 'active' };
        }

        resolveItemLanguage(item);
        if (subtitles.includes(item)) render();
      }
    })();

    return item.prefetchPromise;
  }

  function addSubtitle(rawUrl, source, hint) {
    const url = normalizeSubtitleUrl(rawUrl);
    if (!isSubtitleUrl(url)) return;

    const key = subtitleKey(url);
    const existing = subtitleByKey.get(key);
    const normalizedHint = normalizeLanguageHint(hint);

    if (existing) {
      // Link có token mới: cập nhật để nút Tải dùng link mới nhất.
      existing.url = url;

      if (!existing.languageHint && normalizedHint) {
        existing.languageHint = normalizedHint;
        existing.language = languageFromYoukuCode(normalizedHint.code, normalizedHint.auto);
        if (existing.languageResolved) render();
      }
      return;
    }

    const item = {
      url,
      key,
      source: source || 'network',
      foundAt: Date.now(),
      downloading: false,
      downloaded: false,
      autoTried: false,

      // Chụp lại tên tập/show tại thời điểm bắt được file. Nhờ vậy nếu người
      // dùng chuyển tập mà danh sách chưa kịp xoá, tên file vẫn đúng tập cũ.
      episodeTitle: currentEpisodeTitle(),
      showTitle: currentShowTitle(),
      pageTitle: stripSiteSuffix(document.title),
      pathname: location.pathname,

      languageHint: normalizedHint,
      language: normalizedHint
        ? languageFromYoukuCode(normalizedHint.code, normalizedHint.auto)
        : null,
      detectedLanguage: null,
      languageResolved: false,
      prefetching: false,
      prefetchPromise: null,
      buffer: null,
    };

    subtitles.push(item);
    subtitleByKey.set(key, item);

    ensureUI();
    render();
    pulseFab();

    const languageName = item.language ? item.language.name : '';
    toast(
      `Đã bắt được phụ đề #${subtitles.length}${languageName ? ' · ' + languageName : ''}`,
      2600
    );

    // Bắt đầu tải ngầm ngay từ đầu; nút Tải sẽ dùng lại buffer này.
    startPrefetch(item);

    if (autoDownload && !item.autoTried) {
      item.autoTried = true;
      setTimeout(() => downloadSubtitle(item), 500);
    }
  }

  function handleFoundSubtitle(url, source, hint) {
    if (IS_TOP) {
      addSubtitle(url, source, hint);
    } else {
      try {
        window.top.postMessage(
          {
            __ykAssSubtitle: String(url),
            __ykAssSubtitleLang: normalizeLanguageHint(hint),
          },
