    } catch (_) {
      return;
    }

    for (; performanceIndex < entries.length; performanceIndex++) {
      const name = entries[performanceIndex] && entries[performanceIndex].name;
      if (name && SUB_RE.test(name)) handleFoundSubtitle(name, 'performance', currentLanguageHint());
    }
  }

  function scanDocument() {
    try {
      if (!document.documentElement) return;

      const html = document.documentElement.outerHTML;
      for (const match of html.matchAll(SUB_URL_RE)) {
        handleFoundSubtitle(match[0], 'page');
      }

      document.querySelectorAll('track[src]').forEach(track => {
        if (track.src && isSubtitleUrl(track.src)) handleFoundSubtitle(track.src, 'track');
      });
    } catch (_) { /* bỏ qua */ }
  }

