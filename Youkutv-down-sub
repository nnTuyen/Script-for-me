  }

  function itemDisplayTitle(item, index) {
    refreshItemTitles(item);

    const episode = stripSiteSuffix(item.episodeTitle || '');
    if (episode) return episode;

    const show = stripSiteSuffix(item.showTitle || '');
    if (show) return show;

    const page = stripSiteSuffix(item.pageTitle || '');
    if (page) return page;

    return `Phụ đề ${index + 1}`;
  }

  function itemTitleTooltip(item, fallback) {
    const lines = [];
    const show = stripSiteSuffix(item.showTitle || '');
    const episode = stripSiteSuffix(item.episodeTitle || '');

    if (show && episode) lines.push(`${show} - ${episode}`);
    else if (episode) lines.push(episode);
    else if (show) lines.push(show);
    else lines.push(fallback);

    if (item.language) {
      lines.push(`Ngôn ngữ: ${item.language.name}${item.language.auto ? ' (tự động)' : ''}`);
    }

    lines.push(item.url);
    return lines.join('\n');
  }

  function renderItem(item, index) {
    const row = document.createElement('div');
    row.className = 'item';

    const info = document.createElement('div');
    info.className = 'item-info';

    const name = document.createElement('div');
    name.className = 'item-name';
    const displayTitle = itemDisplayTitle(item, index);
    name.textContent = displayTitle;
    name.title = itemTitleTooltip(item, displayTitle);

    const language = document.createElement('span');
    language.className = 'lang';

    if (item.language) {
      language.textContent = item.language.name + (item.language.auto ? ' (tự động)' : '');
      language.title = item.language.auto
        ? `${item.language.name} · phụ đề dịch tự động`
        : item.language.name;
    } else if (item.prefetching || !item.languageResolved) {
      language.classList.add('pending');
      language.textContent = 'Đang nhận diện…';
      language.title = 'Đang đọc nội dung file phụ đề để nhận diện ngôn ngữ';
    } else {
      language.classList.add('unknown');
      language.textContent = 'Chưa rõ ngôn ngữ';
      language.title = 'Không đọc được ngôn ngữ từ track đang chọn hoặc nội dung file';
    }

    const link = document.createElement('a');
    link.className = 'item-sub';
    link.href = item.url;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.title = `${item.url}\n(Click để mở link gốc)`;
    link.textContent = prettyUrl(item.url);

    const meta = document.createElement('div');
    meta.className = 'item-meta';
    meta.append(language, link);

    info.append(name, meta);

    const actions = document.createElement('div');
    actions.className = 'item-actions';

    const downloadButton = document.createElement('button');
    downloadButton.type = 'button';
    downloadButton.className = 'mini primary';
    downloadButton.textContent = item.downloading ? 'Đang tải…' : (item.downloaded ? 'Tải lại' : 'Tải');
    downloadButton.disabled = !!item.downloading;
    downloadButton.addEventListener('click', () => downloadSubtitle(item));

    const copyButton = document.createElement('button');
    copyButton.type = 'button';
    copyButton.className = 'mini';
    copyButton.textContent = 'Copy';
    copyButton.addEventListener('click', async () => {
      const ok = await copyText(item.url);
      toast(ok ? 'Đã copy link phụ đề.' : 'Không copy được link.', 2200);
    });

    actions.append(downloadButton, copyButton);
    row.append(info, actions);
    return row;
  }

  async function copyText(text) {
    try {
      if (navigator.clipboard && window.isSecureContext) {
        await navigator.clipboard.writeText(text);
        return true;
      }
    } catch (_) { /* thử cách cũ */ }

    try {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.cssText = 'position:fixed;left:-9999px;top:0;opacity:0;';
      (document.body || document.documentElement).appendChild(textarea);
      textarea.focus();
      textarea.select();
      const ok = document.execCommand('copy');
      textarea.remove();
      return ok;
    } catch (_) {
      return false;
    }
  }

  /* ------------------------------------------------------------------ *
   *  Tải file
   * ------------------------------------------------------------------ */

  function gmGetBuffer(url) {
    return new Promise((resolve, reject) => {
      if (typeof GM_xmlhttpRequest !== 'function') {
        reject(new Error('GM_xmlhttpRequest không khả dụng'));
        return;
      }

      try {
        GM_xmlhttpRequest({
          method: 'GET',
          url,
          responseType: 'arraybuffer',
          timeout: 45000,
          onload(response) {
            if (response.status >= 200 && response.status < 300 && response.response) {
              resolve(response.response);
            } else {
              reject(new Error('HTTP ' + response.status));
            }
          },
          onerror() { reject(new Error('lỗi mạng')); },
          ontimeout() { reject(new Error('hết thời gian chờ')); },
          onabort() { reject(new Error('đã huỷ')); },
        });
      } catch (error) {
        reject(error);
      }
    });
  }

  async function directGetBuffer(url) {
    const response = await fetch(url, { credentials: 'omit' });
    if (!response.ok) throw new Error('HTTP ' + response.status);
    return response.arrayBuffer();
  }

  async function getBuffer(url) {
    let gmError = null;

    if (typeof GM_xmlhttpRequest === 'function') {
      try {
        return await gmGetBuffer(url);
      } catch (error) {
        gmError = error;
      }
    }

    try {
      return await directGetBuffer(url);
    } catch (error) {
      if (gmError) {
        throw new Error(`${gmError.message || 'lỗi tải'} / ${error.message || 'lỗi tải'}`);
      }
      throw error;
    }
  }

  function saveBlob(buffer, filename) {
    const blob = new Blob([buffer], { type: 'application/octet-stream' });
    const objectUrl = URL.createObjectURL(blob);

    const anchor = document.createElement('a');
    anchor.href = objectUrl;
    anchor.download = filename;
    anchor.style.display = 'none';
    (document.body || document.documentElement).appendChild(anchor);
    anchor.click();

    setTimeout(() => {
      anchor.remove();
      URL.revokeObjectURL(objectUrl);
    }, 5000);
  }

  function itemBaseName(item) {
    refreshItemTitles(item);

    const episode = stripSiteSuffix(item && item.episodeTitle ? item.episodeTitle : '');
    const show = stripSiteSuffix(item && item.showTitle ? item.showTitle : '');

    if (episode) {
      if (show && !episode.toLowerCase().includes(show.toLowerCase())) {
        return sanitizeFilename(`${show} - ${episode}`);
      }
      return sanitizeFilename(episode);
    }

    const pageTitle = stripSiteSuffix(item && item.pageTitle ? item.pageTitle : '');
    if (pageTitle && !/^(?:优酷|優酷|youku(?:\.tv)?)$/i.test(pageTitle)) {
      return sanitizeFilename(pageTitle);
    }

    return pageBaseName();
  }

  function buildFilename(item) {
    const base = itemBaseName(item);
    const index = subtitles.indexOf(item);
    const language = item.language;
    let suffix = '';

    if (language && typeof language.fileCode === 'string') {
      if (language.fileCode) suffix = `.${language.fileCode}`;

      // Nếu có nhiều phụ đề cùng ngôn ngữ, đánh số để không ghi đè nhau.
      if (index >= 0 && language.code) {
        const sameLanguageBefore = subtitles
          .slice(0, index)
          .filter(other => other.language && other.language.code === language.code)
          .length;

        if (sameLanguageBefore) suffix += ` (${sameLanguageBefore + 1})`;
      }
    } else if (subtitles.length > 1 && index >= 0) {
      suffix = ` (${index + 1})`;
    }

    const extension = /\.ssa(?:[?#]|$)/i.test(item.url) ? 'ssa' : 'ass';
    return `${base}${suffix}.${extension}`;
  }

  async function downloadSubtitle(item, options) {
    const opts = options || {};
    if (!item || item.downloading) return false;

    item.downloading = true;
    if (!opts.quiet) render();

    try {
      // Chờ phần đọc ngầm hoàn tất để dùng lại buffer và biết ngôn ngữ.
      if (!item.buffer && item.prefetchPromise) {
        try { await item.prefetchPromise; } catch (_) { /* bỏ qua */ }
      }

      const buffer = item.buffer || await getBuffer(item.url);
      const filename = buildFilename(item);
      saveBlob(buffer, filename);
      item.downloaded = true;
      toast(`Đã lưu: ${filename}`, 4500);
      return true;
    } catch (error) {
      console.warn('[Youku ASS] Không tải được phụ đề:', error);
      toast(`Không tải được: ${error.message || 'lỗi'}. Link có thể đã hết hạn, hãy tua lại video rồi thử lại.`, 6000);
      return false;
    } finally {
      item.downloading = false;
      render();
    }
  }

  let downloadingAll = false;

  async function downloadAll() {
    if (downloadingAll) return;
    if (!subtitles.length) {
      toast('Chưa có phụ đề nào để tải.', 2400);
      return;
    }

    downloadingAll = true;
    try {
      for (let index = 0; index < subtitles.length; index++) {
        await downloadSubtitle(subtitles[index]);
        if (index < subtitles.length - 1) await sleep(700);
      }
    } finally {
      downloadingAll = false;
      render();
    }
  }

  /* ------------------------------------------------------------------ *
   *  Theo dõi chuyển video (SPA) + nhận link từ iframe
   * ------------------------------------------------------------------ */

  function checkNavigation() {
    if (!IS_TOP) return;
    if (location.pathname === lastPath) return;

    lastPath = location.pathname;
    resetForNewVideo();
  }

  function hookHistory() {
    if (!IS_TOP) return;

    ['pushState', 'replaceState'].forEach(method => {
      try {
        const original = W.history[method];
        if (typeof original !== 'function' || original.__ykAssPatched) return;

        function patched(...args) {
          const result = original.apply(this, args);
          try { checkNavigation(); } catch (_) { /* bỏ qua */ }
          return result;
        }

        patched.__ykAssPatched = true;
        W.history[method] = patched;
      } catch (_) { /* bỏ qua */ }
    });

    W.addEventListener('popstate', checkNavigation);
    setInterval(checkNavigation, 1500);
  }

  function listenForIframeMessages() {
    if (!IS_TOP) return;

    window.addEventListener('message', event => {
      const data = event.data;
      if (!data || typeof data !== 'object' || typeof data.__ykAssSubtitle !== 'string') return;

      const url = data.__ykAssSubtitle;
      try {
        const host = new URL(url, location.href).hostname;
        if (!/(^|\.)(ykimg\.com|youku\.tv|youku\.com)$/i.test(host)) return;
      } catch (_) {
        return;
      }

      addSubtitle(url, 'iframe', data.__ykAssSubtitleLang);
    });
  }

  function registerMenuCommands() {
    if (!IS_TOP || typeof GM_registerMenuCommand !== 'function') return;

    GM_registerMenuCommand('Tải tất cả phụ đề đã bắt', () => {
      setPanelOpen(true);
      downloadAll();
    });

    GM_registerMenuCommand('Bật/tắt tự động tải phụ đề', () => {
      autoDownload = !autoDownload;
      setPref('autoDownload', autoDownload);
      if (els.auto) els.auto.checked = autoDownload;
      toast(autoDownload ? 'Đã bật tự động tải.' : 'Đã tắt tự động tải.', 2200);
    });

    GM_registerMenuCommand('Quét lại trang', () => {
      scanPerformanceEntries();
      scanDocument();
      toast('Đã quét lại trang.', 2200);
    });
  }

  /* ------------------------------------------------------------------ *
   *  Khởi động
   * ------------------------------------------------------------------ */

  hookFetch();
  hookXhr();
  hookSubtitleLanguageMenu();
  hookHistory();
  listenForIframeMessages();
  registerMenuCommands();

  scanPerformanceEntries();

  function boot() {
    ensureUI();
    render();

    scanPerformanceEntries();
    scanDocument();

    setTimeout(scanDocument, 1500);
    setTimeout(scanDocument, 4500);
    setTimeout(scanDocument, 9000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }

  setInterval(scanPerformanceEntries, 3000);

})();
