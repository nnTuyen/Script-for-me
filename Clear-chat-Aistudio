// ==UserScript==
// @name         Google AI Studio | Clear Chat (Turbo)
// @namespace    https://greasyfork.org/en/users/1462137-piknockyou
// @version      3.1
// @author       Nguyễn Ngọc Tuyên (turbo by Antigravity)
// @license      AGPL-3.0
// @description  Xóa tất cả chat siêu nhanh - tự động khôi phục và xóa sạch cả các ô đã bị nén bởi RAM Optimizer.
// @match        https://aistudio.google.com/*
// @icon         https://www.google.com/s2/favicons?sz=64&domain=aistudio.google.com
// @grant        GM_addStyle
// @run-at       document-idle
// @downloadURL  https://raw.githubusercontent.com/nnTuyen/Script-for-me/main/Clear-chat-Aistudio
// @updateURL    https://raw.githubusercontent.com/nnTuyen/Script-for-me/main/Clear-chat-Aistudio
// ==/UserScript==

(function() {
    'use strict';

    if (window.self !== window.top) return;
    console.log("⚡ [Clear Chat Script] v3.1 Turbo - Hỗ trợ xóa ô nén RAM Optimizer...");

    const MESSAGES_TO_KEEP = 0;

    // Selectors
    const CHAT_TURN_SELECTOR = 'ms-chat-turn, ms-prompt-turn, [data-ram-opt-virtualized]';

    const sleep = ms => new Promise(r => setTimeout(r, ms));

    // ─── 0. Hỗ trợ tương thích RAM Optimizer ────────────────────────
    async function ensureTurnRestored(turn) {
        if (!turn) return false;
        const isVirtualized = turn.dataset.ramOptVirtualized === 'true' ||
                              !!turn.querySelector('.ram-opt-btn-restore') ||
                              !!turn.querySelector('.ram-opt-msg-placeholder');
        if (isVirtualized) {
            const restoreBtn = turn.querySelector('.ram-opt-btn-restore');
            if (restoreBtn) {
                restoreBtn.click();
                await sleep(80);
                return true;
            }
        }
        return false;
    }

    function findOptionButton(turn) {
        if (!turn) return null;

        // 1. Selector menu của AI Studio (hỗ trợ cả tiếng Anh lẫn tiếng Việt)
        const optSelectors = [
            'ms-chat-turn-options button',
            'ms-prompt-turn button[aria-label*="More"]',
            'ms-prompt-turn button[aria-label*="Thêm"]',
            'button[aria-label*="More options"]',
            'button[aria-label*="Thêm tùy chọn"]',
            'button.mat-mdc-menu-trigger'
        ];

        for (const sel of optSelectors) {
            const btns = turn.querySelectorAll(sel);
            if (btns.length > 0) {
                return btns[btns.length - 1];
            }
        }

        // 2. Fallback: Quét tất cả button tìm icon hoặc aria liên quan
        const allBtns = Array.from(turn.querySelectorAll('button, [role="button"]'));
        const found = allBtns.find(btn => {
            // Bỏ qua các nút điều khiển do RAM Optimizer gắn vào
            if (btn.classList.contains('ram-opt-collapse-btn') ||
                btn.classList.contains('ram-opt-btn-restore') ||
                btn.classList.contains('ram-opt-btn-delete')) {
                return false;
            }
            const text = (btn.textContent || '').trim();
            const aria = (btn.getAttribute('aria-label') || '').toLowerCase();
            return text.includes('more_vert') || aria.includes('more') || aria.includes('thêm') || aria.includes('option');
        });

        return found || null;
    }

    function findDeleteMenuItem() {
        const menuSelectors = 'button[role="menuitem"], .mat-mdc-menu-item, [role="menu"] button, .mat-menu-item';
        const menuItems = document.querySelectorAll(menuSelectors);
        for (const item of menuItems) {
            const text = (item.textContent || item.innerText || '').toLowerCase();
            const aria = (item.getAttribute('aria-label') || '').toLowerCase();
            if (text.includes('delete') || text.includes('xóa') || text.includes('remove') ||
                aria.includes('delete') || aria.includes('xóa') || aria.includes('remove')) {
                return item;
            }
        }
        return null;
    }

    // ─── 1. Tooltip ────────────────────────────────────────────────
    let gccTooltip = null;
    function showTooltip(btn, text) {
        if (!gccTooltip) {
            gccTooltip = document.createElement('div');
            gccTooltip.style.cssText = `
                position: fixed;
                background: #202124;
                border: 1px solid #5f6368;
                border-radius: 4px;
                padding: 4px 8px;
                font-family: Roboto, sans-serif;
                font-size: 11px;
                color: #e8eaed;
                z-index: 10000;
                pointer-events: none;
                white-space: nowrap;
                box-shadow: 0 4px 6px rgba(0,0,0,0.5);
                opacity: 0;
                transition: opacity 0.1s;
            `;
            document.body.appendChild(gccTooltip);
        }
        gccTooltip.textContent = text;
        const rect = btn.getBoundingClientRect();
        gccTooltip.style.left = `${rect.left + rect.width / 2 - (gccTooltip.offsetWidth / 2)}px`;
        gccTooltip.style.top = `${rect.bottom + 6}px`;
        gccTooltip.style.opacity = '1';
    }

    function hideTooltip() {
        if (gccTooltip) gccTooltip.style.opacity = '0';
    }

    // ─── 2. Shake animation ────────────────────────────────────────
    function shakeButton() {
        const btn = document.getElementById('gemini-cleaner-button');
        if (btn) {
            btn.style.transform = 'translateX(2px)';
            setTimeout(() => btn.style.transform = 'translateX(-2px)', 50);
            setTimeout(() => btn.style.transform = 'none', 100);
        }
    }

    // ─── 3. Xóa siêu nhanh ────────────────────────────────────────

    /**
     * Xóa bằng menu Delete thật của app (bền vững, không hiện lại)
     * - Tự động phục hồi DOM của ô bị RAM optimizer nén
     * - Mở menu "More options" của tin cuối → click Delete/Xóa
     * - Đợi số tin thực sự giảm rồi mới xóa tin kế tiếp
     */
    async function waitForTurnCountLessThan(beforeCount, timeoutMs) {
        const start = performance.now();
        while (performance.now() - start < timeoutMs) {
            await sleep(50);
            const turns = Array.from(document.querySelectorAll(CHAT_TURN_SELECTOR));
            if (turns.length < beforeCount) return true;
        }
        return false;
    }

    async function optimizedClickDelete() {
        let deleted = 0;
        let fails = 0;
        const MAX_FAILS = 3; // Dừng sau 3 lần thất bại liên tiếp

        while (fails < MAX_FAILS) {
            const turns = Array.from(document.querySelectorAll(CHAT_TURN_SELECTOR));
            if (turns.length <= MESSAGES_TO_KEEP) break;

            const lastTurn = turns[turns.length - 1];

            // 1. Phục hồi DOM nếu turn này đang bị nén bởi RAM Optimizer
            await ensureTurnRestored(lastTurn);

            // 2. Tìm nút "More options" trong turn cuối
            let optBtn = findOptionButton(lastTurn);
            if (!optBtn) {
                // Thử chờ thêm 100ms
                await sleep(100);
                optBtn = findOptionButton(lastTurn);
            }

            if (!optBtn) {
                console.warn('⚠️ Không tìm thấy nút menu của turn:', lastTurn);
                fails++;
                continue;
            }

            const beforeCount = turns.length;

            // 3. Click mở menu
            optBtn.click();

            // 4. Tìm và click nút Delete/Xóa trong menu (polling nhanh tới 350ms)
            let deleteItem = null;
            const menuStart = performance.now();
            while (performance.now() - menuStart < 350) {
                await sleep(40);
                deleteItem = findDeleteMenuItem();
                if (deleteItem) break;
            }

            if (!deleteItem) {
                // Đóng menu nếu không tìm thấy nút xóa
                document.body.click();
                await sleep(60);
                fails++;
                continue;
            }

            deleteItem.click();

            // 5. Đợi app xóa thật sự (số tin giảm) trước khi xóa tin kế tiếp
            const removed = await waitForTurnCountLessThan(beforeCount, 3000);
            if (removed) {
                deleted++;
                fails = 0;
            } else {
                fails++;
            }
            await sleep(40);
        }

        return deleted;
    }

    /**
     * HÀM XÓA CHÍNH
     *
     * Flow:
     * 1. Đếm tin nhắn cần xóa (bao gồm cả các ô nén)
     * 2. Phục hồi trước các ô nén để DOM có đầy đủ nút menu và Angular bindings
     * 3. Click Delete từng turn qua menu chính thức của Google AI Studio
     * 4. Đợi app xóa xong từng tin phía server rồi mới xóa tin kế tiếp
     */
    let isDeleting = false;
    async function deleteMessagesFast() {
        if (isDeleting) return; // Chống click nhiều lần
        isDeleting = true;

        const cleanerBtn = document.getElementById('gemini-cleaner-button');
        try {
            const turns = Array.from(document.querySelectorAll(CHAT_TURN_SELECTOR));
            const toDelete = turns.slice(MESSAGES_TO_KEEP);

            if (toDelete.length === 0) {
                shakeButton();
                return;
            }

            if (!confirm(`⚡ Xóa nhanh ${toDelete.length} tin nhắn${MESSAGES_TO_KEEP > 0 ? ` (giữ ${MESSAGES_TO_KEEP} tin đầu)` : ''}?`)) return;

            const startTime = performance.now();

            // Visual feedback: đổi màu nút
            if (cleanerBtn) {
                cleanerBtn.style.color = '#fbbc04';
                cleanerBtn.style.animation = 'spin 1s linear infinite';
            }

            // Phục hồi trước các ô nén trong danh sách cần xóa để sẵn sàng xóa sạch
            let restoredCount = 0;
            for (const turn of toDelete) {
                const restoreBtn = turn.querySelector('.ram-opt-btn-restore');
                if (restoreBtn) {
                    restoreBtn.click();
                    restoredCount++;
                }
            }
            if (restoredCount > 0) {
                console.log(`⚡ Đã tự động khôi phục ${restoredCount} ô nén RAM Optimizer để xóa sạch.`);
                await sleep(150);
            }

            console.log(`⚡ Bắt đầu xóa ${toDelete.length} tin nhắn qua menu Delete...`);
            const clickDeleted = await optimizedClickDelete();
            console.log(`   → Đã xóa qua menu: ${clickDeleted} tin`);

            const remaining = Array.from(document.querySelectorAll(CHAT_TURN_SELECTOR)).length;
            if (remaining > MESSAGES_TO_KEEP) {
                console.log(`⚠️ Còn ${remaining - MESSAGES_TO_KEEP} tin chưa xóa được.`);
            }

            const elapsed = ((performance.now() - startTime) / 1000).toFixed(1);
            console.log(`✅ Hoàn tất xóa ${toDelete.length} tin nhắn trong ${elapsed}s`);

        } catch (err) {
            console.error('❌ Lỗi khi xóa:', err);
        } finally {
            isDeleting = false;
            if (cleanerBtn) {
                cleanerBtn.style.color = '#8e9297';
                cleanerBtn.style.animation = 'none';
            }
        }
    }

    // ─── 4. CSS animation cho nút xóa ─────────────────────────────
    const style = document.createElement('style');
    style.textContent = `
        @keyframes spin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
    `;
    document.head.appendChild(style);

    // ─── 5. Tạo nút xóa ──────────────────────────────────────────
    function createIndestructibleSVGButton() {
        if (document.getElementById('gemini-cleaner-button')) return;

        const buttons = Array.from(document.querySelectorAll('button'));
        const plusBtn = buttons.find(b => {
            const text = (b.innerText || '').trim();
            return text === 'add_circle' || text === 'add';
        });

        if (!plusBtn || !plusBtn.parentElement) return;

        const targetContainer = plusBtn.parentElement;

        const button = document.createElement('button');
        button.id = 'gemini-cleaner-button';
        button.type = 'button';

        button.style.cssText = `
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            width: 40px !important;
            height: 40px !important;
            border-radius: 50% !important;
            cursor: pointer !important;
            color: #8e9297 !important;
            background: transparent !important;
            border: none !important;
            transition: background 0.2s ease, color 0.2s ease !important;
            margin-right: 2px !important;
            flex-shrink: 0 !important;
        `;

        const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        svg.setAttribute("viewBox", "0 0 24 24");
        svg.style.cssText = "width: 24px; height: 24px; fill: currentColor;";
        const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
        path.setAttribute("d", "M15,16h4v2h-4V16z M15,8h7v2h-7V8z M15,12h6v2h-6V12z M3,18c0,1.1,0.9,2,2,2h6c1.1,0,2-0.9,2-2V8H3V18z M14,5h-3l-1-1H6L5,5H2v2h12V5z");
        svg.appendChild(path);
        button.appendChild(svg);

        button.onmouseenter = () => {
            button.style.color = '#d93025';
            button.style.background = 'rgba(232, 234, 237, 0.08)';
            showTooltip(button, `⚡ Xóa nhanh (Giữ ${MESSAGES_TO_KEEP} tin đầu)`);
        };
        button.onmouseleave = () => {
            button.style.color = '#8e9297';
            button.style.background = 'transparent';
            hideTooltip();
        };

        button.onclick = (e) => {
            e.preventDefault();
            e.stopPropagation();
            deleteMessagesFast();
        };

        targetContainer.insertBefore(button, plusBtn);
    }

    setInterval(createIndestructibleSVGButton, 1000);

})();
